# Copy to .env — read by docker compose (NOT by the app directly).

# REQUIRED: long random string used to sign login tokens
#   e.g. openssl rand -hex 32
JWT_SECRET=

# Optional overrides (defaults shown)
# MONGODB_URI=mongodb://mongo:27017/voyagr      # use an Atlas URI to skip the bundled mongo
# NEXT_PUBLIC_API_URL=http://localhost:5000/api # browser-facing; baked in at build time
# CLIENT_ORIGIN=http://localhost:3000
# COOKIE_SECURE=false                           # set true behind HTTPS
