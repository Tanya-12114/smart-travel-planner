{
  "name": "voyagr",
  "version": "1.0.0",
  "description": "Smart Travel Planner — Next.js + Express + MongoDB",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run server:dev\"",
    "next:dev": "next dev -p 3000",
    "next:build": "next build",
    "next:start": "next start",
    "server:dev": "nodemon server/index.js",
    "server:start": "node server/index.js",
    "test": "jest",
    "test:frontend": "vitest run",
    "test:all": "npm run test && npm run test:frontend"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.9.5",
    "next": "14",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "jest": "^30.5.1",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
